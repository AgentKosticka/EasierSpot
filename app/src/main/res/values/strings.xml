    <!-- Help & About Dialog -->
    <string name="help_about_dialog_title">About Easier Spot</string>
    <string name="help_about_dialog_message">
        <![CDATA[
        <b>Easier Spot v%1$s</b><br/><br/>
        <b>What is Easier Spot?</b><br/>
        An Android app that shares Wi-Fi hotspot credentials between devices over Bluetooth Low Energy (BLE).<br/><br/>
        <b>Server Mode Requirements:</b><br/>
        • Notifications permission<br/>
        • Shizuku for privileged hotspot access<br/><br/>
        <b>Client Background Discovery:</b><br/>
        Enable it in Settings to receive a nearby alert for paired phones without keeping EasierSpot open.<br/><br/>
        <b>Wi-Fi Connection Method:</b><br/>
        Suggestion mode keeps “Available via EasierSpot” without creating a second saved network. Shizuku force-connect mode runs Android’s connect-network command and saves the network. The app never runs both methods for one connection.<br/><br/>
        <b>Need Help?</b><br/>
        Visit Diagnostics to troubleshoot Shizuku and hotspot issues. Or you can visit our GitHub repo for reporting issues or further help.
        ]]>
    </string>
    <string name="help_about_dialog_ok">Got it</string>

