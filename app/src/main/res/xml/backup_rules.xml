<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Pairing keys live in Android Keystore and are intentionally device-bound. Restoring the
         database without those keys would create pairings that can never authenticate. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="active_client_session.xml" />
    <exclude domain="sharedpref" path="server_service_state.xml" />
</full-backup-content>
